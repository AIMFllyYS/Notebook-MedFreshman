{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,route,manifest,not-found,error,loading}.{ts,tsx}",
    "electron/**/*.{js,mjs,ts}",
    "scripts/*.{ts,mjs,js}",
    "**/*.test.{ts,tsx}"
  ],
  "project": ["app/**", "components/**", "lib/**", "electron/**", "scripts/*.{ts,mjs,js}"],
  "ignoreDependencies": [
    "electron-builder",
    "@types/mdast"
  ],
  "ignoreBinaries": ["robocopy"],
  "ignoreMembers": ["default"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "lib/ai/agent/tools/index.ts": ["types"],
    "lib/context/index.ts": ["types"],
    "components/visualizations/primitives/index.ts": ["types"]
  },
  "treatConfigHintsAsErrors": false,
  "next": true,
  "vitest": true
}
