# ── 主力对话：自有中转（OpenAI 兼容）────────────────────────────────
# 复制本文件为 .env.local 并填入真实值。.env.local 不会进入 git。
# 真实密钥只写在 .env.local / 云端环境变量，不要提交到 git。

RELAY_BASE_URL=https://relay.protocom.org/v1
RELAY_API_KEY=sk-xxxxxxxxxxxxxxxx

# env 默认模型（站点默认 AI）。菜单可切换到其它已注册模型，
# 或在「设置」里填入自定义 URL/API/模型（与 env 并存不冲突）。
AI_MODEL_PRO=Qwen/Qwen3.8-27B
AI_MODEL_FLASH=z-ai/glm-5.3-flash

# 思考流字段名（DeepSeek/GLM/Qwen 系默认 reasoning_content；不同则改这里）
AI_REASONING_FIELD=reasoning_content

# 可选：若端点需要显式开关思考，置 1
AI_ENABLE_THINKING=

# ── 硅基流动 SiliconFlow（生图 + 向量/重排）────────────────────────
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 小米 MiMo Token Plan（OpenAI 兼容；密钥格式 tp-xxxxx）──────────
# 订阅页：https://platform.xiaomimimo.com/token-plan
# 中国集群：https://token-plan-cn.xiaomimimo.com/v1
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=

# ── 向量 / 重排（语义检索，复用 SiliconFlow 端点）────────────────────────
AI_EMBEDDING_MODEL=BAAI/bge-m3
AI_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 可选：检索模式（hybrid/vector/keyword）。留空或 hybrid 为默认推荐。
AI_SEARCH_MODE=hybrid

# ── 语义检索索引 COS 托管 ────────────────────────────────────────────
# 索引文件（~307MB）不打包进 serverless 函数（outputFileTracingExcludes 排除），
# EdgeOne 运行时从 COS 下载到 /tmp 缓存，本地开发直接读 content/.index/。
# 留空则仅使用本地文件（本地开发模式）。
# 格式：https://<bucket>.cos.<region>.myqcloud.com/index/
COS_INDEX_BASE_URL=

# ── 智谱官方 API（向量/重排容灾 + 联网搜索；对话模型已下架）────────
# 在 https://open.bigmodel.cn 申请 key 后填入；留空则向量容灾与联网搜索不可用。
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=

# 智谱官方向量/重排模型（当 SiliconFlow 不可用时降级使用）
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_RERANK_MODEL=rerank

# ── 联网搜索（智谱 Web Search API）──────────────────────────────────
# 复用上面的 ZHIPU_API_KEY；留空则联网搜索工具返回"未配置"。

# ── 图片搜索（Unsplash API）──────────────────────────────────
# 在 https://unsplash.com/oauth/applications 申请 Access Key 后填入
# 留空则图片搜索工具返回"未配置"，使用 Demo 模式（50次/小时）
UNSPLASH_ACCESS_KEY=

# ── 视频 CDN 托管 ────────────────────────────────────────────────────
# MP4 文件（~900MB）已从仓库移除，托管在腾讯云 COS 或其他 CDN 上。
# 留空则视频从 public/media/videos/ 本地提供（需文件存在）。
# 设置后前端自动将 /media/videos/ 前缀替换为此 base URL。
NEXT_PUBLIC_VIDEO_CDN_BASE=

# ── 离线工具（非运行时，脚本使用）─────────────────────────────────────
# MinerU PDF 解析（scripts/parse-docs.ts 等脚本调用 OpenXLab API）
# 在 https://openxlab.org.cn 申请后填入。
# MinerU_API_Token=
